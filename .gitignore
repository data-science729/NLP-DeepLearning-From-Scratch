*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ==========================================
# 操作系统与 IDE 配置
# ==========================================
.idea/
.vscode/
.agents/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db

# ==========================================
# 超大预训练权重与二进制模型文件 (>50MB / >100MB)
# ==========================================
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
*.npy
*.npz
*.tar
*.tar.gz
*.zip
*.7z

# ==========================================
# 斯坦福 CS224N 预训练词向量文件 (163MB，防 GitHub 拦截)
# ==========================================
**/glove.6B.*
CS224N/**/datasets/*.txt
CS224N/**/datasets/*.npy

# ==========================================
